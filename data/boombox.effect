// BoomBox Stream - zoom + bloom reativos ao áudio.
// Tudo numa única passada: o UV é escalado em torno do centro (zoom) e o
// bloom é uma soma de amostras em espiral (ângulo áureo) das partes claras.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_pixel;        // 1 / tamanho da textura
uniform float2 zoom_center;     // centro do zoom em UV (0..1)
uniform float  zoom;            // >= 1.0
uniform float  bloom_intensity; // 0 = sem bloom
uniform float  bloom_threshold; // 0..1, só o que for mais claro que isso brilha
uniform float  bloom_radius;    // em pixels
uniform float3 bloom_tint;
uniform float  flash;           // ganho extra de brilho no pico

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSBoombox(VertData v_in) : TARGET
{
	float2 uv = zoom_center + (v_in.uv - zoom_center) / zoom;
	float4 base = image.Sample(textureSampler, uv);

	float3 color = base.rgb * (1.0 + flash);

	// Sem "if" em volta do loop: o Direct3D recusa amostrar textura dentro
	// de loop com desvio condicional.
	float3 acc = float3(0.0, 0.0, 0.0);
	float wsum = 0.0;
	float knee = max(1.0 - bloom_threshold, 0.001);

	for (int i = 0; i < 32; i++) {
		float fi = float(i) + 0.5;
		float r = sqrt(fi / 32.0);
		float a = fi * 2.39996323;
		float2 off = float2(cos(a), sin(a)) * (r * bloom_radius) * uv_pixel;
		float4 s = image.Sample(textureSampler, uv + off);
		float3 bright = max(s.rgb - bloom_threshold, 0.0) / knee;
		float w = exp(-2.5 * r * r);
		acc += bright * w;
		wsum += w;
	}

	color += (acc / wsum) * bloom_intensity * bloom_tint;

	float glow = max(max(color.r, color.g), color.b);
	float alpha = saturate(max(base.a, glow));
	return float4(saturate(color), alpha);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBoombox(v_in);
	}
}
